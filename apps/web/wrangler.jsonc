{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzzkit-web",
  "account_id": "71436f45eef790db4fa68442757586ef",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "routes": [{ "pattern": "buzzkit.slumber.group", "custom_domain": true }],

  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "ENVIRONMENT": "production",
    "API_URL": "https://api.buzzkit.slumber.group"
  }
}
