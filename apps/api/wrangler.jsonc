{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzzkit-api",
  "account_id": "71436f45eef790db4fa68442757586ef",
  "routes": [{ "pattern": "api.buzzkit.slumber.group", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // A preview is another version of this same Worker, so it shares every binding: the production
  // database, Tinybird, provider credentials, KV and the subscriber Durable Objects. It is behind
  // the same auth as production, but a send issued from a preview is written to the production
  // database and delivered by production's own queues, so it reaches real devices.
  // BETTER_AUTH_URL and DASHBOARD_URL are vars rather than secrets (they are public URLs) so a
  // preview build can point them at itself and its paired dashboard preview with `--var`.
  // Without that the preview refuses the dashboard's origin and scopes cookies to buzzkit.dev.
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "ENVIRONMENT": "production",
    "WORKFLOW_TIME_SCALE": "1",
    "DASHBOARD_URL": "https://buzzkit.slumber.group",
    "BETTER_AUTH_URL": "https://api.buzzkit.slumber.group/v1/auth",
    "TRACE_SAMPLE_RATIO": "1",
    "TINYBIRD_URL": "https://api.us-east.tinybird.co"
  },

  // Cloudflare Email Service. `remote: true` sends real email even in local
  // dev; the sender domain (libs/email.ts) must be onboarded to Email Sending first.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ddfcbd4e2704419ca3cc0f101d79d663",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5460/buzzkit"
    }
  ],

  // AUTH_CACHE: resolved dashboard sessions (5 min) and API keys (60s, purged on revoke).
  // PROVIDER_CACHE: short-lived provider tokens (APNs JWT, FCM OAuth).
  "kv_namespaces": [
    {
      "binding": "AUTH_CACHE",
      "id": "cc015510124e4786995f05a7262451cf"
    },
    {
      "binding": "PROVIDER_CACHE",
      "id": "591154201d024ab39d2043b0c6b87773"
    },
    {
      "binding": "ENGINE_DEFS",
      "id": "e33ae881eb0a4ccab62459d9169406b1"
    }
  ],

  "queues": {
    "producers": [
      { "queue": "buzzkit-deliveries", "binding": "DELIVERIES" },
      { "queue": "buzzkit-events", "binding": "EVENTS" },
      { "queue": "buzzkit-webhooks", "binding": "WEBHOOKS" }
    ],
    "consumers": [
      {
        "queue": "buzzkit-deliveries",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_concurrency": 40,
        "max_retries": 8,
        "dead_letter_queue": "buzzkit-deliveries-dlq"
      },
      {
        "queue": "buzzkit-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_concurrency": 20,
        "max_retries": 10,
        "dead_letter_queue": "buzzkit-events-dlq"
      },
      {
        "queue": "buzzkit-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 100,
        "dead_letter_queue": "buzzkit-events"
      },
      {
        "queue": "buzzkit-webhooks",
        "max_batch_size": 20,
        "max_batch_timeout": 2,
        "max_concurrency": 20,
        "max_retries": 5,
        "dead_letter_queue": "buzzkit-webhooks-dlq"
      },
      {
        "queue": "buzzkit-deliveries-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3
      },
      {
        "queue": "buzzkit-webhooks-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3
      }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "SUBSCRIBER_ACTOR", "class_name": "SubscriberActor" }]
  },

  "workflows": [{ "name": "buzzkit-workflows", "binding": "ENGINE", "class_name": "EngineWorkflow" }],

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SubscriberActor"] }],

  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *"]
  }
}
